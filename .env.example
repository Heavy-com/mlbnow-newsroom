# News sources
NEWS_API_KEY=
GNEWS_API_KEY=

# Preferred stable Signalizacija credential
SIGNAL_API_TOKEN=sig_live_...
# SIGNALIZACIJA_API_TOKEN is also supported.
# Existing NOCAP_SESSION / nocap_Session remains supported:
# - sig_* value => treated as bearer token
# - other value => treated as legacy browser session cookie

# Google Chat webhooks
GCHAT_MLB=
GCHAT_NFL=
GCHAT_NBA=
GCHAT_NHL=

# Protect alert endpoints
ALERTS_SECRET=
# CRON_SECRET is also supported.
